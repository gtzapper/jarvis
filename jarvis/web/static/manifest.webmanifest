{
  "name": "Jarvis",
  "short_name": "Jarvis",
  "description": "Your homelab assistant",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1216",
  "theme_color": "#0f1216",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chat", "url": "/?view=chat", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lab status", "url": "/?view=dashboard", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
