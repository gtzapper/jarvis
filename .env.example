# Copy to .env and fill in. This file stays on your machine.
PVE_TOKEN_ID=jarvis@pve!monitor
PVE_TOKEN_SECRET=paste-the-secret-proxmox-shows-you-once

PFSENSE_API_KEY=paste-the-key-from-pfsense

# Write-capable credentials, used only to create VMs and reserve IPs
PVE_ADMIN_TOKEN_ID=jarvis-admin@pve!provision
PVE_ADMIN_TOKEN_SECRET=
PFSENSE_ADMIN_API_KEY=

# Media stack (Settings > General > API Key in each app)
